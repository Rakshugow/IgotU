<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Navigation Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IgotU"
                    android:textColor="#00F2FE"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hardware GPS &amp; Anti-Spoof Sentinel"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_badge_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ACTIVE"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="@drawable/bg_badge_secure"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- 24/7 Background Sentinel Toggle Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D131F"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toStartOf="@+id/switch_sentinel"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24/7 Background Sentinel"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guarding Google Maps, WhatsApp &amp; system apps"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_sentinel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true"
                    app:useMaterialThemeColors="true" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hero Security Status HUD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0E1424"
            app:strokeColor="#1E293B"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="26dp"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_hud_circle"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:id="@+id/img_status_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_shield_secure"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCANNING SENSORS..."
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_verdict_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hardware and Android OS integrity verified"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic Kill & Neutralize Banner (Visible during spoofing or on demand) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_neutralize"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Kill Fake GPS &amp; Revert to Real GPS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="#EF4444"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Anti-Bypass Dual Mini-Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <!-- Card 1: Root Shield -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#0D131F"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROOT SHIELD"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_root_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clean (No Root)"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Hook Shield -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#0D131F"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOOK SHIELD"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_hook_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clean (No Hooks)"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Live Telemetry Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D131F"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE SENSOR TELEMETRY"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tv_mock_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="isMock: FALSE"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <!-- Coordinates Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_accent"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COORDINATES (TAP TO COPY)"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_coords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acquiring GPS fix..."
                        android:textColor="#00F2FE"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_provider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Provider: GPS"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_accuracy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accuracy: ±0.0 m"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Incident History Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D131F"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INCIDENT AUDIT LOG"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tv_incident_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Incidents"
                        android:textColor="#00F2FE"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_recent_incidents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No spoofing incidents detected yet."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="14dp" />

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export_csv"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Export CSV"
                        android:textSize="12sp"
                        android:textColor="#070A10"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_share"
                        app:iconTint="#070A10"
                        app:iconGravity="textStart"
                        app:backgroundTint="#00F2FE"
                        app:cornerRadius="10dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_logs"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Clear Logs"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        app:icon="@drawable/ic_trash"
                        app:iconTint="#94A3B8"
                        app:iconGravity="textStart"
                        app:backgroundTint="#172033"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Installed Fake GPS Apps Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D131F"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTALLED MOCK APPS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_mock_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanning installed packages..."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Scan Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Scan Hardware &amp; Sensors"
            android:textColor="#070A10"
            android:textStyle="bold"
            android:textSize="14sp"
            app:icon="@drawable/ic_satellite"
            app:iconTint="#070A10"
            app:iconGravity="textStart"
            app:backgroundTint="#00F2FE"
            app:cornerRadius="12dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
